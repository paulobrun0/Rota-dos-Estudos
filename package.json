{
  "name": "ciclo-estudos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "start": "node server/index.js",
    "restore": "node server/restore.js",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "concurrently": "^10.0.5",
    "jsdom": "26.1.0",
    "pdfjs-dist": "^4.10.38",
    "vite-plugin-pwa": "^1.3.0"
  }
}
